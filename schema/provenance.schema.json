{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindwalk.local/schema/provenance.schema.json",
  "title": "mindwalk observatory provenance record",
  "description": "Where a displayed fact came from and how much to trust it. Raw source content is never stored; rawEventHash is the SHA-256 of the raw record.",
  "type": "object",
  "required": ["sourceType", "quality"],
  "additionalProperties": false,
  "properties": {
    "sourceType": { "type": "string", "minLength": 1 },
    "sourceName": { "type": "string" },
    "sourceEventId": { "type": "string" },
    "rawEventHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "quality": { "$ref": "#/$defs/quality" },
    "fieldQuality": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/quality" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "explanation": { "type": "string" }
  },
  "if": {
    "properties": { "quality": { "const": "derived" } }
  },
  "then": {
    "required": ["sourceType", "quality", "explanation"],
    "properties": { "explanation": { "minLength": 1 } }
  },
  "$defs": {
    "quality": {
      "enum": ["exact", "estimated", "derived", "unavailable", "redacted"]
    }
  }
}
